# MongoDB connection string (Atlas or local). Required.
MONGODB_URI="mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?appName=<app>"

# Database name for Mnemo. Optional — overrides the database in MONGODB_URI.
MONGODB_DB=mnemo

# Enables "Generate with AI" for key takeaways and flashcards. Optional.
ANTHROPIC_API_KEY="sk-ant-..."
